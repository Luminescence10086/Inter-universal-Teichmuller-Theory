      "citations": [
        {
          "locator": "L105-L109",
          "page": null,
          "topic": "out : forall {B} {h}, BPS.Iso B <etUnit h, thetaValD> -> Ind3 D -> Region D - the output is a bare structure field"
        },
        {
          "locator": "L112-L114",
          "page": null,
          "topic": "T1 ind12_acts_on_S: exists tau, FORALL S, out (...) S = out iota (tau S) - the only legitimate forall-over-S in the interface"
        },
        {
          "locator": "L117-L119",
          "page": null,
          "topic": "T2 etUnitOnly"
        },
        {
          "locator": "L143-L147",
          "page": null,
          "topic": "etaAnab iota S := B.val.eta (logVol D (A.out iota S))"
        },
        {
          "locator": "L151-L153",
          "page": null,
          "topic": "etaAnab_eq_etaQ_iff: etaAnab iota S = etaQ D <-> logVol (out iota S) = qPilot.lhs"
        },
        {
          "locator": "L169-L175",
          "page": null,
          "topic": "def Wall D A := forall (h1 h2) (_gl), exists (iota) (S), etaAnab iota S = etaQ D - THE quantifier order"
        },
        {
          "locator": "L183-L186",
          "page": null,
          "topic": "wall_iff_forall: the Theta-link datum is vacuous, the forall over the pair remains outside the exists"
        },
