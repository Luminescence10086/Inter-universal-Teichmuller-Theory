  "theorems": {
    "minimality_arbitrary_products": {
      "name": "OrbitQuotient.hull_least_coordinateProduct",
      "statement": "{p N n : Nat} (Gamma : Finset (Equiv.Perm (Fin n))) (hGamma : Gamma.Nonempty) (k : Fin n -> Nat) (S : Fin n -> Set (ZMod (p ^ N))) : orbitUnion p N n Gamma k subset Set.pi Set.univ S <-> Box p N n (hullThresh Gamma hGamma k) subset Set.pi Set.univ S",
      "role": "least product of arbitrary coordinate subsets (both directions of the task definition of H)",
      "axioms": [
        "propext",
        "Classical.choice",
        "Quot.sound"
      ]
    },
    "minimality_from_products": {
      "name": "OrbitQuotient.hull_minimal_from_products",
      "statement": "{p N n : Nat} (Gamma : Finset (Equiv.Perm (Fin n))) (hGamma : Gamma.Nonempty) (k : Fin n -> Nat) : (forall x, orbitUnion p N n Gamma k x -> Box p N n (hullThresh Gamma hGamma k) x) /\\ (forall k' : Fin n -> Nat, (forall x, orbitUnion p N n Gamma k x -> Box p N n k' x) -> forall x, Box p N n (hullThresh Gamma hGamma k) x -> Box p N n k' x)",
      "role": "old bounded-threshold minimality (hull_minimal) derived from the arbitrary-product theorem; no primality and no k' <= N",
      "axioms": [
        "propext",
        "Classical.choice",
        "Quot.sound"
      ]
    },
    "containment_and_minimality_product_form": {
      "name": "OrbitQuotient.hull_minimal_coordinateProduct",
      "statement": "conjunction form: U subset Box (hullThresh ...) and forall S, U subset Set.pi Set.univ S -> Box (hullThresh ...) subset Set.pi Set.univ S",
      "role": "previous round's repair, retained",
      "axioms": [
        "propext",
        "Classical.choice",
        "Quot.sound"
      ]
    },
    "product_hull_equals_box": {
      "name": "OrbitQuotient.coordinateProductHull_orbitUnion",
      "role": "coordinateProductHull (orbitUnion ...) = Box p N n (hullThresh ...)",
