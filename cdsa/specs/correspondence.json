{
  "goal": "Regenerate the semantic-correspondence ledger and independently verify it, then record a human-owned synthesis claim that names its own objection.",
  "budgets": {
    "max_nodes": 4,
    "max_parallel": 2
  },
  "nodes": [
    {
      "id": "N1-regen",
      "role": "generate",
      "executor": {
        "kind": "command",
        "argv": ["python", "-B", "bridges/correspondence_gen.py"],
        "cwd": "."
      },
      "allowed_paths": ["bridges/"],
      "claim_template": "correspondence ledger regenerated by correspondence_gen.py (exit {code})",
      "dissent_template": "generation only proves the ledger is internally anchored; it does not prove any entry's 'proves' field is a faithful reading of its theorem",
      "confidence": 0.7,
      "confidence_floor": 0.6,
      "timeout": 300,
      "evidence_files": ["bridges/correspondence.json"],
      "forbidden_in_claim": ["IUT 已证明", "abc 已证", "closed the gap"],
      "produces_claim": "correspondence-ledger"
    },
    {
      "id": "N2-verify",
      "role": "verify",
      "executor": {
        "kind": "command",
        "argv": ["python", "-B", "bridges/check_correspondence.py"],
        "cwd": "."
      },
      "allowed_paths": [],
      "claim_template": "independent ledger verifier passed (exit {code})",
      "dissent_template": "the verifier checks anchors, tiers, sections and companions; it cannot check whether the prose overstates the cited theorem",
      "confidence": 0.75,
      "confidence_floor": 0.6,
      "timeout": 300,
      "evidence_files": ["bridges/correspondence.json"],
      "forbidden_in_claim": ["proves the mathematics"],
      "produces_claim": "correspondence-verified"
    },
    {
      "id": "N3-synthesis",
      "role": "synthesise",
      "executor": {
        "kind": "handoff",
        "template": "fill claim/evidence/confidence/dissent for the round synthesis"
      },
      "allowed_paths": ["research/exploration/"],
      "claim_template": "round synthesis recorded",
      "dissent_template": "the synthesis is a research narrative; its only machine evidence is the ledger and its verifier",
      "confidence": 0.7,
      "confidence_floor": 0.6,
      "timeout": 60,
      "evidence_files": [
        "research/exploration/RESULTS.md",
        "bridges/correspondence.json"
      ],
      "forbidden_in_claim": ["proved Corollary 3.12", "proved abc"],
      "produces_claim": "round-synthesis"
    }
  ],
  "edges": [
    {
      "from": "N1-regen",
      "to": "N2-verify",
      "verify": ["ancestors_green", "envelope_valid", "evidence_resolves", "dissent_present"]
    },
    {
      "from": "N2-verify",
      "to": "N3-synthesis",
      "verify": ["ancestors_green", "evidence_resolves", "confidence_above",
                 "dissent_present", "artifact_hash_stable"]
    }
  ]
}
