{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hull-v1.schema.json",
  "title": "Finite permutation hull request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "p", "N", "thresholds", "permutations"],
  "properties": {
    "schema": {"const": 1},
    "p": {"type": "integer", "minimum": 2, "maximum": 2147483647},
    "N": {"type": "integer", "minimum": 0, "maximum": 10000},
    "thresholds": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "integer", "minimum": 0}},
    "permutations": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "array", "items": {"type": "integer", "minimum": 0}}},
    "require_enlargement": {"type": "boolean", "default": true}
  },
  "$comment": "The component additionally checks primality, threshold bounds, and each permutation's bijectivity and dimension."
}
