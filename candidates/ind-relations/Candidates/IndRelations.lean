import Mathlib.NumberTheory.Padics.PadicNumbers
import Mathlib.Data.Fintype.Perm

/-!
# Relation-valued Ind1–Ind3 allowed operations: a toy-but-faithful model

This file formalises the *shape* of the Ind1/Ind2/Ind3 allowed-operations family, not the
object.  Read it together with

* `research/exploration/correspondence.md`, entries C-01 (slot relabelling), C-03 (joint
  admissibility is not a product relation) and the "next three goals" table, whose first
  item is exactly this file's deliverable;
* `research/round3-realization-obligations.md`, RI-01/RI-04/RI-05.

## What is *faithful* here

* `Allowed12` is **relation-valued**: `Allowed12 x y` is `∃` a relabelling generator, `∃` a
  slotwise scalar choice, and an equation.  It is not a function `Tuple → Tuple`, it is not
  a group action, and it never claims that its generators are elements of one monoid of
  isomorphisms (the ledger's forbidden identification **F-01**).
* `ambient` is the larger `A(k)`-style family: *all* slot permutations and *all* nonzero
  slotwise scalars.  `allowed12_subset` proves the inclusion as a theorem, and
  `allowed12_strict` proves `Allowed12` is **strictly smaller**, with an explicit witness.
* `CompositionClosed` is a **target**, stated for an arbitrary relation `ℛ`.  It is proved
  only under explicit hypotheses (`compositionClosed_of_closed`), and it is **refuted** for
  the concrete generator family (`not_compositionClosed`), so it is never an assumption.
* The projection equation is proved as an identity on the coordinates of the moved tuple.

## What is *toy*

* The tuple type is `Fin 4 → ℚ_[p]`: four slots of actual p-adic numbers.  There is no
  Hodge theater, no `Ism`, no Kummer element, no Θ-link, no Cor 3.12; the label set is an
  abstract `Fin 4`, not the slot set of a real Hodge theater.
* The relabelling family `Gamma12` is `{1, swap 0 1}` and the scaling family `S` is
  `{1, flip₀}` (value set `{±1} ⊆ ℚ_[p]^×` on the slot profile `{0}`, `1` off it).  The
  *shape* (finite value set × slot profile, relation-valued) is the point; the *content* of
  the real `Ind1`–`Ind3` procession is absent.
* Nothing here constructs the Θ-link, `Ism`, or Cor 3.12, and nothing here closes any gap
  in any argument about IUT.

## Main results

| name | statement |
|---|---|
| `move_projection` | `move σ a x (σ j) = a j * x j` |
| `move_projection_source` | `move σ (pull σ a) x (σ j) = a (σ j) * x j` |
| `allowed12_subset` | `Allowed12 x y → ambient x y` |
| `allowed12_strict` | `∃ x y, ambient x y ∧ ¬ Allowed12 x y` |
| `compositionClosed_of_closed` | hypotheses on `Γ12`/`S` imply `CompositionClosed Allowed12` |
| `not_compositionClosed` | `¬ CompositionClosed Allowed12` |
| `gamma12_trans_mem` | `Γ12` *is* closed under the composition rule, so the failure is on the `S` side |
| `not_scaling_family_closed` | the `S`-side hypothesis of `compositionClosed_of_closed` fails |
-/

set_option autoImplicit false

namespace Candidates.IndRelations

noncomputable section

/-! ## The toy tuple type and the two kinds of slot moves -/

/-- The toy tuple type: four slots of actual `ℚ_[p]` numbers. -/
abbrev Tuple (p : ℕ) [Fact p.Prime] : Type := Fin 4 → ℚ_[p]

variable {p : ℕ} [Fact p.Prime]

/-- Slot relabelling by a permutation: `σ` moves the content of source slot `j` to slot
`σ j`, i.e. `relabel σ x` is `x` pulled back along `σ`. -/
def relabel (σ : Equiv.Perm (Fin 4)) (x : Tuple p) : Tuple p := fun i => x (σ.symm i)

/-- Slotwise scaling by a family of units of `ℚ_[p]^×`. -/
def scale (a : Fin 4 → ℚ_[p]ˣ) (x : Tuple p) : Tuple p := fun i => (a i : ℚ_[p]) * x i

/-- Reindex a scalar family along a permutation: `pull τ a` is `a` transported to the
target slots, `(pull τ a) k = a (τ k)`. -/
def pull (τ : Equiv.Perm (Fin 4)) (a : Fin 4 → ℚ_[p]ˣ) : Fin 4 → ℚ_[p]ˣ := fun k => a (τ k)

/-- **One generator move**: scale slotwise, then relabel.  This is the single element of
the toy "allowed operation" family, kept as a map only here — `Allowed12` below is the
relation generated by these, never a group action. -/
def move (σ : Equiv.Perm (Fin 4)) (a : Fin 4 → ℚ_[p]ˣ) (x : Tuple p) : Tuple p :=
  relabel σ (scale a x)

/-- The unit vector in slot `i` (value `1` in slot `i`, `0` elsewhere). -/
def e (i : Fin 4) : Tuple p := Pi.single i (1 : ℚ_[p])

/-- `-1` is different from `1` in `ℚ_[p]`: `ℚ_[p]` has characteristic zero. -/
theorem neg_one_ne_one : (-1 : ℚ_[p]) ≠ 1 := by
  intro h
  have h' : ((-1 : ℚ) : ℚ_[p]) = ((1 : ℚ) : ℚ_[p]) := by simpa using h
  have h2 : (-1 : ℚ) = 1 := Rat.cast_injective h'
  norm_num at h2

/-- `-1` is nonzero in `ℚ_[p]`. -/
theorem neg_one_ne_zero : (-1 : ℚ_[p]) ≠ 0 := by simp

/-! ## Structural lemmas on relabelling and scaling -/

theorem relabel_relabel (ρ σ : Equiv.Perm (Fin 4)) (x : Tuple p) :
    relabel ρ (relabel σ x) = relabel (σ.trans ρ) x := by
  funext i
  simp only [relabel, Equiv.symm_trans_apply]

theorem scale_scale (a b : Fin 4 → ℚ_[p]ˣ) (x : Tuple p) :
    scale a (scale b x) = scale (a * b) x := by
  funext i
  simp only [scale, Pi.mul_apply, Units.val_mul, mul_assoc]

theorem scale_relabel (a : Fin 4 → ℚ_[p]ˣ) (σ : Equiv.Perm (Fin 4)) (y : Tuple p) :
    scale a (relabel σ y) = relabel σ (scale (pull σ a) y) := by
  funext i
  simp only [scale, relabel, pull, Equiv.apply_symm_apply]

theorem relabel_single (σ : Equiv.Perm (Fin 4)) (i : Fin 4) (c : ℚ_[p]) :
    relabel σ (Pi.single i c : Tuple p) = (Pi.single (σ i) c : Tuple p) := by
  funext k
  show (Pi.single i c : Tuple p) (σ.symm k) = (Pi.single (σ i) c : Tuple p) k
  by_cases h : k = σ i
  · have h' : σ.symm k = i := by rw [h, Equiv.symm_apply_apply]
    rw [h', Pi.single_eq_same, h, Pi.single_eq_same]
  · have h' : σ.symm k ≠ i := by
      intro hh
      have hk : σ (σ.symm k) = σ i := by rw [hh]
      rw [Equiv.apply_symm_apply] at hk
      exact h hk
    rw [Pi.single_eq_of_ne h', Pi.single_eq_of_ne h]

theorem scale_single (a : Fin 4 → ℚ_[p]ˣ) (i : Fin 4) (c : ℚ_[p]) :
    scale a (Pi.single i c : Tuple p) = (Pi.single i ((a i : ℚ_[p]) * c) : Tuple p) := by
  funext k
  show (a k : ℚ_[p]) * (Pi.single i c : Tuple p) k
    = (Pi.single i ((a i : ℚ_[p]) * c) : Tuple p) k
  by_cases h : k = i
  · subst h
    rw [Pi.single_eq_same, Pi.single_eq_same]
  · rw [Pi.single_eq_of_ne h, Pi.single_eq_of_ne h, mul_zero]

/-- A generator move sends the unit vector of slot `i` to the unit vector of slot `σ i`,
scaled by `a i`. -/
theorem move_e (σ : Equiv.Perm (Fin 4)) (a : Fin 4 → ℚ_[p]ˣ) (i : Fin 4) :
    move σ a (e i) = (Pi.single (σ i) ((a i : ℚ_[p])) : Tuple p) := by
  have h : (e i : Tuple p) = (Pi.single i (1 : ℚ_[p])) := rfl
  rw [move, h, scale_single, relabel_single, mul_one]

/-- The negative of a unit vector is the unit vector carrying `-1`. -/
theorem neg_e (i : Fin 4) : (-(e i) : Tuple p) = (Pi.single i (-1 : ℚ_[p]) : Tuple p) := by
  funext k
  show -(Pi.single i (1 : ℚ_[p]) : Tuple p) k = (Pi.single i (-1 : ℚ_[p]) : Tuple p) k
  by_cases h : k = i
  · subst h
    rw [Pi.single_eq_same, Pi.single_eq_same]
  · rw [Pi.single_eq_of_ne h, Pi.single_eq_of_ne h]
    simp

theorem move_apply (σ : Equiv.Perm (Fin 4)) (a : Fin 4 → ℚ_[p]ˣ) (x : Tuple p) (i : Fin 4) :
    move σ a x i = (a (σ.symm i) : ℚ_[p]) * x (σ.symm i) := rfl

/-! ## The projection equation

The ledger states the projection equation as
`(relabel σ (scale a x)) (σ j) = a (σ j) * x j`.  The exact statement proved below is
`move_projection`; `move_projection_source` is the ledger's literal form, which holds when
the scalar family is indexed on the *source* slots (`pull σ a`), not on the target slots.
See the README for this correction. -/

/-- **Projection equation (target-indexed form).**  Projecting the slot `σ j` of the moved
tuple returns the scalar sitting at that slot times the corresponding source slot `j`. -/
theorem move_projection (σ : Equiv.Perm (Fin 4)) (a : Fin 4 → ℚ_[p]ˣ) (x : Tuple p)
    (j : Fin 4) : move σ a x (σ j) = (a j : ℚ_[p]) * x j := by
  rw [move_apply, Equiv.symm_apply_apply]

/-- **Projection equation (the ledger's literal form).**  With the scalar family transported
to the source slots — `pull σ a` — projecting slot `σ j` returns `a (σ j) * x j`, exactly as
written in the ledger. -/
theorem move_projection_source (σ : Equiv.Perm (Fin 4)) (a : Fin 4 → ℚ_[p]ˣ) (x : Tuple p)
    (j : Fin 4) : move σ (pull σ a) x (σ j) = (a (σ j) : ℚ_[p]) * x j := by
  rw [move_projection]
  rfl

/-! ## Composition of two generator moves -/

/-- **Composition rule.**  Applying the generator `(σ, a)` and then `(ρ, b)` is again a
single generator: the composite permutation is `σ.trans ρ`, and the composite scalar family
is `pull σ b * a`.  This is the rule against which the closure hypothesis is stated. -/
theorem move_move (ρ : Equiv.Perm (Fin 4)) (b : Fin 4 → ℚ_[p]ˣ) (σ : Equiv.Perm (Fin 4))
    (a : Fin 4 → ℚ_[p]ˣ) (x : Tuple p) :
    move ρ b (move σ a x) = move (σ.trans ρ) (pull σ b * a) x := by
  rw [move, move, scale_relabel, relabel_relabel, scale_scale, move]

/-! ## The two explicit finite families -/

/-- The relabelling family `Γ12`: a list, so that membership is a proposition that needs
no `DecidableEq` on the permutation group in the statements. -/
def Gamma12 : List (Equiv.Perm (Fin 4)) := [1, Equiv.swap 0 1]

theorem mem_Gamma12 (σ : Equiv.Perm (Fin 4)) :
    σ ∈ Gamma12 ↔ σ = 1 ∨ σ = Equiv.swap 0 1 := by
  simp [Gamma12]

/-- `Γ12` is closed under the composition rule: it is a subgroup of `S₄`. -/
theorem gamma12_trans_mem : ∀ σ ∈ Gamma12, ∀ ρ ∈ Gamma12, σ.trans ρ ∈ Gamma12 := by
  intro σ hσ ρ hρ
  rw [mem_Gamma12] at hσ hρ ⊢
  rcases hσ with rfl | rfl <;> rcases hρ with rfl | rfl
  · exact Or.inl rfl
  · exact Or.inr rfl
  · exact Or.inr rfl
  · exact Or.inl (by decide)

/-- The signed flip of slot `0`: multiply slot `0` by `-1`, leave the other slots alone. -/
def flip0 : Fin 4 → ℚ_[p]ˣ := fun i => if i = 0 then -1 else 1

/-- The scaling family `S`: the finite value set `{±1} ⊆ ℚ_[p]^×` applied on the slot
profile `{0}`, and `1` off the profile. -/
def S : List (Fin 4 → ℚ_[p]ˣ) := [1, flip0]

theorem mem_S (a : Fin 4 → ℚ_[p]ˣ) : a ∈ S ↔ a = 1 ∨ a = flip0 := by
  simp [S]

theorem flip0_val_zero : (flip0 (p := p) 0 : ℚ_[p]) = -1 := by simp [flip0]

theorem flip0_val_one : (flip0 (p := p) 1 : ℚ_[p]) = 1 := by simp [flip0]

/-! ## The relation-valued allowed family and the ambient `A(k)` family -/

/-- **`Allowed12`, relation-valued.**  `y` is obtained from `x` by one generator of the toy
Ind1/Ind2 allowed family: a relabelling `σ ∈ Γ12` together with a slotwise scalar choice
`a ∈ S`.  This is a relation on tuples — not a function, not a group action, and not an
identification of the generators with elements of one monoid of isomorphisms. -/
def Allowed12 (x y : Tuple p) : Prop :=
  ∃ σ ∈ Gamma12, ∃ a ∈ S, y = move σ a x

/-- **`ambient`, the larger `A(k)`-style family**: *every* slot permutation and *every*
nonzero slotwise scalar family. -/
def ambient (x y : Tuple p) : Prop :=
  ∃ σ : Equiv.Perm (Fin 4), ∃ a : Fin 4 → ℚ_[p]ˣ, y = move σ a x

/-- **Inclusion is a theorem, not a definition.**  Every allowed operation is an ambient
`A(k)`-style operation. -/
theorem allowed12_subset (x y : Tuple p) : Allowed12 x y → ambient x y := by
  rintro ⟨σ, -, a, -, rfl⟩
  exact ⟨σ, a, rfl⟩

/-! ## Strictness: `Allowed12` is *strictly* smaller than the ambient family -/

/-- The ambient family contains the move `e 3 ↦ e 2` (relabel by `swap 2 3`). -/
theorem ambient_e3_e2 : ambient (p := p) (e 3) (e 2) := by
  refine ⟨Equiv.swap 2 3, 1, ?_⟩
  rw [move_e]
  simp [e]

/-- **The strictness witness.**  `Allowed12` does **not** contain the move `e 3 ↦ e 2`:
every generator of `Γ12` fixes slot `3`, and every scalar of `S` is `1` in slot `3`, so the
value `1` carried by slot `3` can be neither removed nor moved by an allowed operation,
while the ambient family moves it to slot `2`.

The failing coordinate profile is therefore: *slot `3` carries a nonzero value while slot
`2` carries `0`* — the profile `(0,0,0,1)` (source) versus `(0,0,1,0)` (target). -/
theorem not_allowed12_e3_e2 : ¬ Allowed12 (p := p) (e 3) (e 2) := by
  rintro ⟨σ, hσ, a, ha, hEq⟩
  have ha3 : (a 3 : ℚ_[p]) = 1 := by
    rcases (mem_S a).mp ha with rfl | rfl
    · rfl
    · exact flip0_val_one
  have hσ3 : σ 3 = 3 := by
    rcases (mem_Gamma12 σ).mp hσ with rfl | rfl
    · rfl
    · decide
  have himg : move σ a (e 3) = e 3 := by
    rw [move_e, hσ3, ha3]
    rfl
  have hEq' : e 2 = e 3 := hEq.trans himg
  have hcoord : (e 2 : Tuple p) 3 = (e 3 : Tuple p) 3 := congrFun hEq' 3
  simp [e] at hcoord

/-- **Strictness.**  There is an ambient `A(k)` operation that is not allowed. -/
theorem allowed12_strict : ∃ x y : Tuple p, ambient x y ∧ ¬ Allowed12 x y :=
  ⟨e 3, e 2, ambient_e3_e2, not_allowed12_e3_e2⟩

/-! ## Composition closure: a target, never an assumption -/

/-- `CompositionClosed ℛ` says that `ℛ` is transitive.  This is the property the ledger
requires only for the real Ind1/Ind2/Ind3 family and only under explicit hypotheses;
nothing below assumes it for `Allowed12`. -/
def CompositionClosed (ℛ : Tuple p → Tuple p → Prop) : Prop :=
  ∀ x y z, ℛ x y → ℛ y z → ℛ x z

/-- **Conditional composition closure.**  If the relabelling family is closed under the
composition rule `σ.trans ρ`, and the scaling family is closed under the corresponding
scalar rule `pull σ b * a`, then `Allowed12` is transitive.

Both hypotheses are stated, neither is an assumption about the real Ind family: the first is
*discharged* for the concrete `Γ12` by `gamma12_trans_mem`, and the second is *refuted* for
the concrete `S` by `not_scaling_family_closed`. -/
theorem compositionClosed_of_closed
    (hΓ : ∀ σ ∈ Gamma12, ∀ ρ ∈ Gamma12, σ.trans ρ ∈ Gamma12)
    (hS : ∀ σ ∈ Gamma12, ∀ a ∈ (S (p := p)), ∀ b ∈ (S (p := p)),
      pull σ b * a ∈ (S (p := p))) :
    CompositionClosed (Allowed12 (p := p)) := by
  intro x y z hxy hyz
  rcases hxy with ⟨σ, hσ, a, ha, rfl⟩
  rcases hyz with ⟨ρ, hρ, b, hb, rfl⟩
  exact ⟨σ.trans ρ, hΓ σ hσ ρ hρ, pull σ b * a, hS σ hσ a ha b hb, move_move ρ b σ a x⟩

/-- The `S`-side hypothesis of `compositionClosed_of_closed` is false for the concrete
scaling family: `pull (swap 0 1) flip0 * 1` is the flip of slot `1`, which is not in `S`. -/
theorem not_scaling_family_closed :
    ¬ (∀ σ ∈ Gamma12, ∀ a ∈ (S (p := p)), ∀ b ∈ (S (p := p)),
      pull σ b * a ∈ (S (p := p))) := by
  intro h
  let c : Fin 4 → ℚ_[p]ˣ := pull (Equiv.swap 0 1) (flip0 (p := p)) * (1 : Fin 4 → ℚ_[p]ˣ)
  have hmem : c ∈ S :=
    h (Equiv.swap 0 1) ((mem_Gamma12 _).mpr (Or.inr rfl)) (1 : Fin 4 → ℚ_[p]ˣ)
      ((mem_S (1 : Fin 4 → ℚ_[p]ˣ)).mpr (Or.inl rfl))
      (flip0 (p := p)) ((mem_S (flip0 (p := p))).mpr (Or.inr rfl))
  have hval : (c 1 : ℚ_[p]) = -1 := by
    simp [c, pull, flip0]
  rcases (mem_S c).mp hmem with h1 | h2
  · have hone : (c 1 : ℚ_[p]) = 1 := by
      rw [h1]
      simp
    rw [hval] at hone
    exact neg_one_ne_one hone
  · have hone : (c 1 : ℚ_[p]) = 1 := by
      rw [h2]
      exact flip0_val_one
    rw [hval] at hone
    exact neg_one_ne_one hone

/-- **Composition closure genuinely fails** for the raw generator family.  The witness is

* `x = e 1`, `y = e 0`, `z = -e 1`;
* `Allowed12 (e 1) (e 0)` via the generator `(swap 0 1, 1)`;
* `Allowed12 (e 0) (-e 1)` via the generator `(swap 0 1, flip0)`;
* but `¬ Allowed12 (e 1) (-e 1)`: every allowed image of `e 1` is `e 0` or `e 1`, never
  `-e 1`.

So `CompositionClosed Allowed12` is false: composing two allowed moves yields a move along
the composite permutation whose scalar family is `pull σ b * a`, which need not lie in `S`.
This is why composition closure must remain a target with explicit hypotheses. -/
theorem not_compositionClosed : ¬ CompositionClosed (Allowed12 (p := p)) := by
  intro hclosed
  have step1 : Allowed12 (p := p) (e 1) (e 0) := by
    refine ⟨Equiv.swap 0 1, (mem_Gamma12 _).mpr (Or.inr rfl), 1, (mem_S _).mpr (Or.inl rfl), ?_⟩
    rw [move_e]
    simp [e]
  have step2 : Allowed12 (p := p) (e 0) (-(e 1)) := by
    refine ⟨Equiv.swap 0 1, (mem_Gamma12 _).mpr (Or.inr rfl), (flip0 (p := p)),
      (mem_S _).mpr (Or.inr rfl), ?_⟩
    rw [move_e, neg_e]
    simp [flip0]
  have hstep := hclosed (e 1) (e 0) (-(e 1)) step1 step2
  rcases hstep with ⟨σ, hσ, a, ha, hEq⟩
  have ha1 : (a 1 : ℚ_[p]) = 1 := by
    rcases (mem_S a).mp ha with rfl | rfl
    · rfl
    · exact flip0_val_one
  have hcoord : (-(e 1) : Tuple p) 1 = (move σ a (e 1)) 1 := congrFun hEq 1
  rw [move_e] at hcoord
  rcases (mem_Gamma12 σ).mp hσ with rfl | rfl
  · rw [show ((1 : Equiv.Perm (Fin 4)) 1) = 1 from rfl, ha1] at hcoord
    simp [e] at hcoord
    exact neg_one_ne_one hcoord
  · rw [show ((Equiv.swap 0 1 : Equiv.Perm (Fin 4)) 1) = 0 from by decide, ha1] at hcoord
    -- `hcoord` is now `-1 = 0`, which `simp` closes
    simp [e] at hcoord

end

end Candidates.IndRelations
