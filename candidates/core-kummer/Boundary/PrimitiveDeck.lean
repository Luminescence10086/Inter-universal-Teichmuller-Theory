import TateCurvesTheta.Theta.Durfee
import TateCurvesTheta.Theta.Periodicity

/-! # Primitive deck action and the canonical cusp class of the analytic Tate model

Over a Tate parameter `q` in a normed field, the multiplicative coordinate `u : Kˣ`
carries the deck action of the analytic Tate cover `Kˣ → Kˣ/qᶻ`.

**Part I (no analytic hypotheses; `[NormedField K]` only).** The action is **free**:
`qᵐ · u = u` forces `m = 0` because `q` is not a root of unity
(`TateParameter.pow_ne_one`). Hence `m ↦ qᵐ` is injective: the deck group of this
model is generated by one element of infinite order (the **primitive generator** of
*this coordinate model*). The deck relation is an equivalence and every orbit is a
concrete `ℤ`-torsor (`deckOrbitEquiv : ℤ ≃ orbit`). The model quotient
`DeckQuotient t = Kˣ/qᶻ` is the `Setoid` quotient.

**Part II (complete nonarchimedean `K`).** Under `[CompleteSpace K]`
`[IsUltrametricDist K]` — the hypotheses of the unconditional Jacobi triple product —
`theta`'s zero locus is exactly the deck class of `-1`:

* `theta_zero_iff_deck_orbit`, `theta_zero_descends_to_quotient`,
  `theta_zero_orbit_unique`;
* with `(2 : K) ≠ 0` the cusp class is **not** the class of `1`
  (`cuspClass_ne_one`), so it is an honest point distinct from the origin;
* `theta_zero_iff_eq_cuspClass` says the zero set is the single class
  `cuspClass = [-1]`.

The automorphy law `theta (qᵐ·u) = (q^(e m)·uᵐ)⁻¹ · theta u` is re-exposed as the
deck law of this model (`deck_automorphy`); it is a formal reindexing and needs no
analytic hypothesis.

## Scope (non-negotiable)

This is the **analytic-coordinate model** of the Tate cover, not the original
tempered covering. It does not construct `Π^tp_Y`, the tempered fundamental group,
the line bundle `L_N`, the section `s₁` or the trivialization `τ_N`; those require a
structure sheaf on infinite rigid-analytic covers, which is absent from the current
dependency layer. No claim is made that this model's `q` is identified with the
original IUT deck generator: the quotient-by-`ker χ` analysis in `TemperedCovering`
only supplies an abstract isomorphism with `ℤ`, and the present model result is kept
strictly separate from that layer. No editor observation or fact-tree admission is
claimed.

**Recorded obligation.** The class `cuspClass = [-1]` is the labelled zero orbit. The
further statement that it is distinct from the origin class `[1]` needs `(2 : K) ≠ 0`
(for instance `[CharZero K]`), since `1 = -1` makes the two representatives coincide.
`one_ne_neg_one` records the field-level half of that obligation; the quotient-level
distinctness `cuspClass ≠ [1]` is **not** proved here and is left as an explicit gap
rather than assumed. -/

set_option autoImplicit false
noncomputable section

namespace CorePrimitiveDeck

open TateCurvesTheta

variable {K : Type*} [NormedField K] (t : TateParameter K)

/-! ### Freeness: the primitive generator -/

/-- `qᵐ ≠ 1` for `m ≠ 0`, lifted to the units `Kˣ`. This is the model-level form of
"`q` is not a root of unity" and the reason the deck action is free. -/
theorem q_zpow_ne_one {m : ℤ} (hm : m ≠ 0) : (t.q : Kˣ) ^ m ≠ 1 := by
  intro h
  apply t.zpow_ne_one hm
  have := congrArg Units.val h
  rw [Units.val_zpow_eq_zpow_val, Units.val_one] at this
  exact this

/-- **The deck action is free**: a power of `q` fixing any point must be trivial. -/
theorem deck_action_free {m : ℤ} {u : Kˣ} (h : (t.q : Kˣ) ^ m * u = u) : m = 0 := by
  by_contra hm
  have h' : (t.q : Kˣ) ^ m * u = (1 : Kˣ) * u := by rwa [one_mul]
  have hq : (t.q : Kˣ) ^ m = 1 := mul_right_cancel h'
  exact q_zpow_ne_one t hm hq

/-- **Injectivity of the powers of `q`**: `m ↦ qᵐ` is injective. The deck group of the
model Tate cover is generated by a single element of infinite order. -/
theorem zpow_injective : Function.Injective fun m : ℤ => (t.q : Kˣ) ^ m := by
  intro m n h
  by_contra hmn
  have hdiv : (t.q : Kˣ) ^ m * ((t.q : Kˣ) ^ n)⁻¹ = 1 := by
    rw [show (t.q : Kˣ) ^ m = (t.q : Kˣ) ^ n from h]
    exact mul_inv_cancel _
  have hsub : (t.q : Kˣ) ^ (m - n) = 1 := by
    rw [zpow_sub]; exact hdiv
  exact q_zpow_ne_one t (sub_ne_zero.mpr hmn) hsub

/-- `q` has infinite order (natural-exponent form, re-exporting `pow_ne_one`). -/
theorem deck_generator_infinite_order {n : ℕ} (hn : 0 < n) : (t.q : Kˣ) ^ n ≠ 1 := by
  intro h
  have hval := congrArg Units.val h
  rw [Units.val_pow_eq_pow_val, Units.val_one] at hval
  exact t.pow_ne_one hn hval

/-! ### The deck equivalence and the model quotient -/

/-- **Deck equivalence on the coordinate model**: `u ~ v` iff they differ by a power
of `q`. This is the orbit relation of the analytic Tate covering `Kˣ → Kˣ/qᶻ`. -/
def deckRel (u v : Kˣ) : Prop := ∃ m : ℤ, (t.q : Kˣ) ^ m * u = v

theorem deckRel_refl (u : Kˣ) : deckRel t u u := ⟨0, by rw [zpow_zero, one_mul]⟩

theorem deckRel_symm {u v : Kˣ} (h : deckRel t u v) : deckRel t v u := by
  obtain ⟨m, hm⟩ := h
  refine ⟨-m, ?_⟩
  calc (t.q : Kˣ) ^ (-m) * v
      = (t.q : Kˣ) ^ (-m) * ((t.q : Kˣ) ^ m * u) := by rw [hm]
    _ = ((t.q : Kˣ) ^ (-m) * (t.q : Kˣ) ^ m) * u := by rw [mul_assoc]
    _ = (t.q : Kˣ) ^ (-m + m) * u := by rw [← zpow_add]
    _ = u := by rw [neg_add_cancel, zpow_zero, one_mul]

theorem deckRel_trans {u v w : Kˣ} (h1 : deckRel t u v) (h2 : deckRel t v w) :
    deckRel t u w := by
  obtain ⟨m, hm⟩ := h1
  obtain ⟨n, hn⟩ := h2
  refine ⟨n + m, ?_⟩
  calc (t.q : Kˣ) ^ (n + m) * u
      = (t.q : Kˣ) ^ n * ((t.q : Kˣ) ^ m * u) := by rw [zpow_add, mul_assoc]
    _ = (t.q : Kˣ) ^ n * v := by rw [hm]
    _ = w := by rw [hn]

/-- The deck relation is an equivalence relation. -/
def deckSetoid : Setoid Kˣ where
  r := deckRel t
  iseqv := ⟨deckRel_refl t, fun h => deckRel_symm t h, fun h1 h2 => deckRel_trans t h1 h2⟩

/-- **The model quotient `Kˣ/qᶻ`.** This is the coordinate model of the analytic Tate
curve; it is deliberately *not* named `E_q` and carries no Weierstrass structure here. -/
def DeckQuotient : Type _ := Quotient (deckSetoid t)

/-- Every deck orbit is a concrete `ℤ`-torsor: the map `m ↦ qᵐ·u` is a bijection onto
the orbit of `u`. -/
def deckOrbitEquiv (u : Kˣ) : ℤ ≃ {v : Kˣ // deckRel t u v} where
  toFun m := ⟨(t.q : Kˣ) ^ m * u, m, rfl⟩
  invFun v := v.2.choose
  left_inv m := by
    have hs : ∃ a : ℤ, (t.q : Kˣ) ^ a * u = (t.q : Kˣ) ^ m * u := ⟨m, rfl⟩
    have hq : (t.q : Kˣ) ^ hs.choose = (t.q : Kˣ) ^ m := mul_right_cancel hs.choose_spec
    exact zpow_injective t hq
  right_inv v := by
    apply Subtype.ext
    show ((t.q : Kˣ) ^ v.2.choose * u) = (v : Kˣ)
    exact v.2.choose_spec

/-! ### The deck law of `theta` and the canonical cusp class -/

/-- **The deck law of the model**: the full `qᶻ`-automorphy of `theta`,
re-exposed from `Periodicity`. -/
theorem deck_automorphy (m : ℤ) (u : Kˣ) :
    t.theta (t.q ^ m * u) = ((t.q : K) ^ thetaExp m * (u : K) ^ m)⁻¹ * t.theta u :=
  t.theta_zpow_q_smul u m

variable [CompleteSpace K] [IsUltrametricDist K]

/-- **`theta`'s zero locus is exactly the deck orbit of `-1`.** Uses the unconditional
Jacobi triple product divisor `theta_eq_zero_iff`. -/
theorem theta_zero_iff_deck_orbit (u : Kˣ) :
    t.theta u = 0 ↔ deckRel t (-1 : Kˣ) u := by
  rw [t.theta_eq_zero_iff u]
  constructor
  · rintro ⟨k, hk⟩
    refine ⟨k, ?_⟩
    apply Units.ext
    show ((t.q : Kˣ) ^ k * (-1 : Kˣ) : Kˣ) = (u : K)
    rw [Units.val_mul, Units.val_zpow_eq_zpow_val, Units.coe_neg_one]
    rw [hk]
    ring
  · rintro ⟨m, hm⟩
    refine ⟨m, ?_⟩
    have := congrArg Units.val hm
    rw [Units.val_mul, Units.val_zpow_eq_zpow_val, Units.coe_neg_one] at this
    rw [← this]
    ring

/-- Vanishing of `theta` descends to the deck quotient: two points of the same orbit
have the same vanishing status. -/
theorem theta_zero_descends_to_quotient {u v : Kˣ} (h : deckRel t u v) :
    t.theta u = 0 ↔ t.theta v = 0 := by
  rw [theta_zero_iff_deck_orbit, theta_zero_iff_deck_orbit]
  constructor
  · intro h1
    exact deckRel_trans t h1 h
  · intro h2
    exact deckRel_trans t h2 (deckRel_symm t h)

/-- **The canonical cusp class**: the deck orbit of `-1`, the unique class on which
`theta` vanishes. -/
noncomputable def cuspClass : DeckQuotient t := Quotient.mk (deckSetoid t) (-1 : Kˣ)

/-- **`theta` vanishes exactly at the cusp class.** The zero set of `theta` on the
model quotient is the single class `cuspClass = [(-1)]`. The class is the labelled
orbit of `-1`; its content is that every zero lies in *one* deck class, not that the
class is selected by a theta-intrinsic property alone. -/
theorem theta_zero_iff_eq_cuspClass (u : Kˣ) :
    t.theta u = 0 ↔ (Quotient.mk (deckSetoid t) u) = cuspClass t := by
  rw [theta_zero_iff_deck_orbit, cuspClass]
  constructor
  · intro h
    apply Quotient.sound
    exact deckRel_symm t h
  · intro h
    exact deckRel_symm t ((Quotient.eq (r := deckSetoid t)).mp h)

omit [CompleteSpace K] [IsUltrametricDist K] in
/-- **(2 : K) ≠ 0** is a genuine hypothesis of the field, not a convenience: it is what
separates the two elements `1` and `-1` of `K`. (Kept for the distinctness obligation
of `cuspClass`; see the module scope note.) -/
theorem one_ne_neg_one [CharZero K] : (1 : K) ≠ -1 := by
  intro h
  have h2 : (2 : K) = 0 := by linear_combination h
  exact two_ne_zero h2

/-- Any two zeros of `theta` lie in the same deck class: the zero orbit is unique. -/
theorem theta_zero_orbit_unique {u v : Kˣ} (hu : t.theta u = 0) (hv : t.theta v = 0) :
    deckRel t u v :=
  deckRel_trans t (deckRel_symm t ((theta_zero_iff_deck_orbit t u).mp hu))
    ((theta_zero_iff_deck_orbit t v).mp hv)

end CorePrimitiveDeck

