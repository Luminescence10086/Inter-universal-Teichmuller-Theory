import ResidueHaar
import Mathlib.RingTheory.Ideal.Maps
import Mathlib.RingTheory.Ideal.Span

/-! Finite quotient certificates for actual coefficient-ring ideal hulls.
The coefficient ring and the quotient homomorphism must be supplied, not inferred
from mere Q_p-linearity of an action. -/
set_option autoImplicit false
open MeasureTheory Set
open scoped ENNReal

namespace CoreResidueHull

/-- A nonempty full cylinder already generates the kernel of its quotient map.
Consequently taking its ideal hull commutes exactly with pulling back the
finite quotient ideal hull. Nonemptiness is essential. -/
theorem span_cylinder_eq {R S : Type*} [CommRing R] [CommRing S]
    (f : R →+* S) (hsurj : Function.Surjective f) (s : Set S) (hne : s.Nonempty) :
    Ideal.span (f ⁻¹' s) = Ideal.comap f (Ideal.span s) := by
  let I : Ideal R := Ideal.span (f ⁻¹' s)
  have hker : Ideal.comap f ⊥ ≤ I := by
    obtain ⟨a, ha⟩ := hne
    obtain ⟨b, hb⟩ := hsurj a
    intro x hx
    have hfx : f x = 0 := hx
    have hbI : b ∈ I := Ideal.subset_span (by simpa only [Set.mem_preimage, hb] using ha)
    have hxbI : x + b ∈ I := Ideal.subset_span (by
      simpa only [Set.mem_preimage, map_add, hfx, hb, zero_add] using ha)
    simpa only [add_sub_cancel_right] using I.sub_mem hxbI hbI
  calc
    Ideal.span (f ⁻¹' s) = I ⊔ Ideal.comap f ⊥ := (sup_of_le_left hker).symm
    _ = Ideal.comap f (Ideal.map f I) := (Ideal.comap_map_of_surjective f hsurj I).symm
    _ = Ideal.comap f (Ideal.span s) := by
      dsimp only [I]
      rw [Ideal.map_span, Set.image_preimage_eq s hsurj]

noncomputable section

/-- Finite carrier of a proposed residue ideal. Producing and checking such an
ideal can be separated from the analytic volume argument. -/
def idealResidues {S : Type*} [CommRing S] [Fintype S] (J : Ideal S) : Finset S := by
  classical
  exact Finset.univ.filter (fun x => x ∈ J)

theorem coe_idealResidues {S : Type*} [CommRing S] [Fintype S] (J : Ideal S) :
    (idealResidues J : Set S) = (J : Set S) := by
  classical
  ext x
  simp [idealResidues]

/-- Haar volume of the actual pullback of a finite residue ideal. -/
theorem comap_measure {R S : Type*} [CommRing R] [CommRing S]
    [MeasurableSpace R] [MeasurableAdd R] [Fintype S]
    (μ : Measure R) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant]
    (f : R →+* S) (hsurj : Function.Surjective f)
    (hmeas : ∀ a, MeasurableSet (f ⁻¹' {a})) (J : Ideal S) :
    μ (Ideal.comap f J : Set R) = ((idealResidues J).card : ℝ≥0∞) / Fintype.card S := by
  have heq : (Ideal.comap f J : Set R) = f ⁻¹' (idealResidues J : Set S) := by
    rw [coe_idealResidues]
    rfl
  rw [heq]
  exact CoreResidueHaar.cylinder_measure μ f.toAddMonoidHom hsurj hmeas (idealResidues J)

/-- A finite residue ideal containing the reduction of A bounds the genuine
coefficient-ring hull of A, even when A is not a full cylinder or not measurable.
The input is a containment certificate, not the desired volume inequality. -/
theorem hull_measure_le_of_residue_cover {R S : Type*} [CommRing R] [CommRing S]
    [MeasurableSpace R] [MeasurableAdd R] [Fintype S]
    (μ : Measure R) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant]
    (f : R →+* S) (hsurj : Function.Surjective f)
    (hmeas : ∀ a, MeasurableSet (f ⁻¹' {a})) (A : Set R) (J : Ideal S)
    (hcover : ∀ x ∈ A, f x ∈ J) :
    μ (Ideal.span A : Set R) ≤ ((idealResidues J).card : ℝ≥0∞) / Fintype.card S := by
  have hle : Ideal.span A ≤ Ideal.comap f J := Ideal.span_le.mpr hcover
  calc
    μ (Ideal.span A : Set R) ≤ μ (Ideal.comap f J : Set R) := measure_mono hle
    _ = _ := comap_measure μ f hsurj hmeas J

/-- One common finite residue ideal controls the hull of every allowed image
at once. The family may be infinite and the actions need not preserve volume.
All actions and the cover must use the same ring quotient f. -/
theorem saturation_hull_measure_le {R S T : Type*} [CommRing R] [CommRing S]
    [MeasurableSpace R] [MeasurableAdd R] [Fintype S]
    (μ : Measure R) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant]
    (f : R →+* S) (hsurj : Function.Surjective f)
    (hmeas : ∀ a, MeasurableSet (f ⁻¹' {a}))
    (A : Set R) (s : Set S) (u : T → R → R) (v : T → S → S)
    (hcomm : ∀ i x, f (u i x) = v i (f x))
    (hA : ∀ x ∈ A, f x ∈ s) (J : Ideal S)
    (hcover : ∀ i a, a ∈ s → v i a ∈ J) :
    μ (Ideal.span (⋃ i, u i '' A) : Set R) ≤
      ((idealResidues J).card : ℝ≥0∞) / Fintype.card S := by
  apply hull_measure_le_of_residue_cover μ f hsurj hmeas (⋃ i, u i '' A) J
  intro y hy
  obtain ⟨i, x, hx, rfl⟩ := Set.mem_iUnion.mp hy
  rw [hcomm]
  exact hcover i (f x) (hA x hx)

/-- The finite residue carrier of the ideal generated by a finite input. -/
def hullResidues {S : Type*} [CommRing S] [Fintype S] (s : Finset S) : Finset S := by
  classical
  exact Finset.univ.filter (fun x => x ∈ Ideal.span (s : Set S))

theorem coe_hullResidues {S : Type*} [CommRing S] [Fintype S] (s : Finset S) :
    (hullResidues s : Set S) = (Ideal.span (s : Set S) : Set S) := by
  classical
  ext x
  simp [hullResidues]

/-- Exact Haar volume of an actual ideal hull, using only a finite quotient hull
certificate. No target volume occurs as a field of the input object. -/
theorem quotient_hull_measure {R S : Type*} [CommRing R] [CommRing S]
    [MeasurableSpace R] [MeasurableAdd R] [Fintype S]
    (μ : Measure R) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant]
    (f : R →+* S) (hsurj : Function.Surjective f)
    (hmeas : ∀ a, MeasurableSet (f ⁻¹' {a})) (s : Finset S) (hne : s.Nonempty) :
    μ (Ideal.span (f ⁻¹' (s : Set S)) : Set R) =
      ((hullResidues s).card : ℝ≥0∞) / Fintype.card S := by
  classical
  rw [span_cylinder_eq f hsurj (s : Set S) hne.to_set]
  have heq : (Ideal.comap f (Ideal.span (s : Set S)) : Set R) =
      f ⁻¹' (hullResidues s : Set S) := by
    rw [coe_hullResidues]
    rfl
  rw [heq]
  exact CoreResidueHaar.cylinder_measure μ f.toAddMonoidHom hsurj hmeas (hullResidues s)

/-- Specialization to any finite-dimensional Z_p standard lattice, any precision,
and its actual coordinatewise coefficient-ring hull. -/
theorem padic_hull_measure (p : ℕ) [Fact p.Prime] (ι : Type*) [Fintype ι] [DecidableEq ι]
    (k : ℕ) (s : Finset (ι → ZMod (p ^ k))) (hne : s.Nonempty) :
    CoreResidueHaar.latticeHaar p ι
      (Ideal.span (CoreResidueHaar.reduction p ι k ⁻¹' (s : Set (ι → ZMod (p ^ k)))) :
        Set (ι → ℤ_[p])) =
      ((hullResidues s).card : ℝ≥0∞) / ((p ^ k) ^ Fintype.card ι : ℕ) := by
  classical
  simpa [Fintype.card_fun] using quotient_hull_measure
    (CoreResidueHaar.latticeHaar p ι) (CoreResidueHaar.reduction p ι k)
    (CoreResidueHaar.reduction_surjective p ι k)
    (fun a => (CoreResidueHaar.reduction_continuous p ι k).measurable
      (measurableSet_singleton a)) s hne

end
end CoreResidueHull

