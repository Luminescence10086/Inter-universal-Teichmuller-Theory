#print axioms CoreResidueHull.comap_measure
#print axioms CoreResidueHull.hull_measure_le_of_residue_cover
#print axioms CoreResidueHull.saturation_hull_measure_le
#print axioms CoreResidueHull.coe_hullResidues
#print axioms CoreResidueHull.quotient_hull_measure
#print axioms CoreResidueHull.padic_hull_measure
